@page
@using Set07.Cafes.Part2
@namespace Set07.Cafes.Part2.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model Set07.Cafes.Part2.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Cafes";
}

<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 2rem; line-height: 1.4; }
        ul { padding-left: 1.25rem; }
        li { margin-bottom: 0.35rem; }
    </style>
</head>
<body>
    <h1>Matthew Innes — B01841977</h1>

    <p>
        Showing <strong>Cafes</strong> from <strong>Cafes.db</strong>.
        Each name is clickable and uses the link stored in the database.
    </p>

    @if (Model.Items.Count == 0)
    {
        <p>
            Nothing was returned.
            This usually means the database file is missing beside the built website,
            or the table name/column names do not match.
        </p>
    }
    else
    {
        <ul>
            @foreach (var item in Model.Items)
            {
                <!-- This line matches: item.Url (from DB) becomes the href, item.Text becomes the clickable text. -->
                <li><a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Text</a></li>
            }
        </ul>
    }
</body>
</html>
