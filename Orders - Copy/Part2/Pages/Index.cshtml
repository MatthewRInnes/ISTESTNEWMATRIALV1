@* FILE TYPE: Razor view (.cshtml). This is the HTML template the browser receives. *@
@page
@* DIRECTIVE: @page = “this file is a routable page”. *@

@* DIRECTIVE: @namespace sets the namespace for this view. *@
@* Same as the namespace line in `Pages/Index.cshtml.cs`: `namespace Orders.Pages;` *@
@* PROBLEM: this view is in the Orders namespace, so it is not an Orders page. *@
@* If this project is meant to be Orders Part2, this namespace should be Orders.Pages (matching Pages/Index.cshtml.cs). *@
@namespace Orders.Pages

@* DIRECTIVE: @model tells Razor which PageModel class this view reads from. *@
@* Same as the PageModel class in `Pages/Index.cshtml.cs`: `public class IndexModel : PageModel` *@
@* PROBLEM: this model type is Orders.Pages.IndexModel; Orders Part2 would be Orders.Pages.IndexModel (or whatever your Orders PageModel is called). *@
@model Orders.Pages.IndexModel

@* RAZOR CODE BLOCK: runs on the server before HTML is sent. *@
@{
    // Browser tab Orders and default heading context (referenced below as @ViewData["Orders"]).
    ViewData["Orders"] = "Orders";
}

@* HTML5 document type for standards mode rendering. *@
<!doctype html>
@* Root element; lang helps screen readers and search engines with language. *@
<html lang="en-GB">
@* Document metadata and embedded CSS for this simple standalone page. *@
<head>
    @* Declares UTF-8 so special characters display correctly. *@
    <meta charset="utf-8" />
    @* Viewport meta tag for sensible scaling on phones and tablets. *@
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Tab Orders taken from the ViewData dictionary set in the @{ } block above. *@
    <Orders>@ViewData["Orders"]</Orders>
    @* Inline styles keep this sample self-contained without separate CSS files. *@
    <style>
        @* Page-wide font, spacing, and line height for readability. *@
        body { font-family: Arial, sans-serif; margin: 2rem; line-height: 1.4; }
        @* Indent bullet lists slightly from the left edge. *@
        ul { padding-left: 1.25rem; }
        @* Space between list items so links are easier to tap or click. *@
        li { margin-bottom: 0.35rem; }
    </style>
</head>
@* Visible page content starts here. *@
<body>
    @* Coursework-style identification line at the top of the body. *@
    <h1>Matthew Innes — B01841977</h1>

    @* Explains that the list is loaded from my SQLite file and the table that maps to the entity. *@
    <p>Orders from the SQLite database file (mapped table for this page), each linking to the stored Orders URL.</p>

    @* If the query returned no rows, show a helpful message instead of an empty list. *@
    @* PROPERTY: Model.Orders comes from `Pages/Index.cshtml.cs`:
       `public List<Order> Orders { get; private set; } = [];` *@
    @if (Model.Orders.Count == 0)
    {
        @* Warns that the database file may be missing from the web output folder. *@
        <p>No rows were returned. Check that the database file exists beside the built site output.</p>
    }
    else
    {
        @* Start an unordered list; each item will be one platform link. *@
        <ul>
            @* Loop each entity row loaded in OnGetAsync. *@
            @* ENTITY: `Order` is one Order entity (one row from the Orders table). *@
            @foreach (var Order in Model.Orders)
            {
                @* ENTITY PROPERTIES (SQL-backed): *@
                @* - `Order.CustomerName` maps to SQL column `CustomerName` in `Orders.sql`. *@
                @* - `Order.OrdersUrl` maps to SQL column `OrdersURL` in `Orders.sql`. *@
                <li><a href="@Order.OrdersUrl" target="_blank" rel="noopener noreferrer">@Order.CustomerName</a></li>
            }
        </ul>
    }
</body>
</html>
