@page
@namespace MusicPlatforms.Pages
@model MusicPlatforms.Pages.IndexModel
@{
    ViewData["Title"] = "Music platforms";
}

<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 2rem; line-height: 1.4; }
        ul { padding-left: 1.25rem; }
        li { margin-bottom: 0.35rem; }
    </style>
</head>
<body>
    <h1>Matthew Innes — B01841977</h1>

    <p>Platforms from <strong>MusicPlatforms.db</strong> (table <strong>MusicPlatforms</strong>), ordered by URL string ascending, each linking to the stored URL.</p>

    @if (Model.Platforms.Count == 0)
    {
        <p>No rows were returned. Check that <strong>MusicPlatforms.db</strong> exists beside the built site.</p>
    }
    else
    {
        <ul>
            @foreach (var site in Model.Platforms)
            {
                <li><a href="@site.Url" target="_blank" rel="noopener noreferrer">@site.Name</a></li>
            }
        </ul>
    }
</body>
</html>
